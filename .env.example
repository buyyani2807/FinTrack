# Create a Supabase project, then copy these values from Project Settings → API.
# Never place the service-role key in this file or in the browser app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Public site origin used in Auth emails (Forgot password) and Open Graph / rich-link
# preview absolute URLs (og:image, og:url). On Vercel set this to the deployed URL
# (e.g. https://staging-fintrack.vercel.app). Also add the same origin under Supabase →
# Authentication → URL Configuration → Redirect URLs, and set Site URL to the
# production/staging app (not http://localhost).
# VITE_APP_ORIGIN=https://staging-fintrack.vercel.app

# Signup controls (signup is shown by default; set false to hide Create business account)
# VITE_ALLOW_PUBLIC_SIGNUP=false
# VITE_SIGNUP_INVITE_CODE=your-pilot-invite

# Optional client error tracking (Sentry). Leave empty to turn it off.
# Events are scrubbed of phones, emails, PAN, Aadhaar, tokens and URL query strings
# before they leave the browser (src/lib/monitoring.js).
# VITE_SENTRY_DSN=
# Defaults to staging / production from the hostname; set to override.
# VITE_SENTRY_ENVIRONMENT=

# Vercel serverless only (same Supabase URL/anon key + service role):
# SUPABASE_SERVICE_ROLE_KEY=

# Module commerce (Razorpay). Without these, Unlock returns 501 and never grants entitlements.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Vercel only. Reads a supplier bill photo into a purchase draft. Never put this in the browser app.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
